---
// A public photo when the person has one (circular, slightly desaturated, with a hairline field ring);
// otherwise their field signature with their initials. Never a generated face.
import type { Person } from "../data/people";
import { BASE } from "../lib/look";
import { signature } from "../lib/signature";
const { person, size = 56 } = Astro.props as { person: Person; size?: number };
const initials = person.name.split(/\s+/).map((w) => w[0]).slice(0, 2).join("");
const PREVIEW = Boolean(import.meta.env.MAXWELL_PREVIEW);
const showPhoto = person.photo && (person.photoSource?.consent === "given" || PREVIEW);
const pending = showPhoto && person.photoSource?.consent !== "given";
const sig = showPhoto ? null : signature(person.name);
const id = `clip-${person.id}-${size}`;
---
<span class="avatar" style={`--s:${size}px`}>
  {showPhoto ? (
    <>
      <img src={`${BASE}${person.photo}`} alt={`Photo of ${person.name}`} width={size} height={size} loading="lazy" />
      {pending && <span class="avatar__pending" title="Preview only: waiting for this person's consent">pending consent</span>}
      <svg class="avatar__ring" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="46" /><path d="M9.5 34 A49 49 0 0 1 34 9.5" /><path d="M90.5 66 A49 49 0 0 1 66 90.5" /></svg>
    </>
  ) : (
    <svg class="avatar__sig" viewBox="0 0 100 100" role="img" aria-label={`${person.name} (no photo)`}>
      <defs><clipPath id={id}><circle cx="50" cy="50" r="50" /></clipPath></defs>
      <g clip-path={`url(#${id})`}>
        <rect width="100" height="100" class="sig__bg" />
        {sig!.waves.map((w) => <circle cx={sig!.cx} cy={sig!.cy} r={w.r} class:list={["sig__line", { "sig__line--cu": w.copper }]} />)}
        {sig!.loops.map((l) => <path d={l.d} class:list={["sig__line", { "sig__line--cu": l.copper }]} />)}
      </g>
      <circle cx="50" cy="50" r="20" class="sig__core" />
      <text x="50" y="50.5" class="sig__ini" text-anchor="middle" dominant-baseline="central">{initials}</text>
    </svg>
  )}
</span>

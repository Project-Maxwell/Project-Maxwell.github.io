---
// Direction B: one paper as a card with its figure on top.
import type { Paper } from "../data/papers";
import { DIRECTIONS } from "../data/site";
import Authors from "./Authors.astro";
import Stats from "./Stats.astro";
import PaperFigure from "./PaperFigure.astro";
const { paper, feature = false } = Astro.props as { paper: Paper; feature?: boolean };
const dir = DIRECTIONS.find((d) => d.id === paper.direction)!;
const home = paper.links[0]?.url;
const rest = paper.title.startsWith(paper.name + ":") ? paper.title.slice(paper.name.length + 1).trim() : paper.title;
---
<article class:list={["pcard", { "pcard--feature": feature }]} id={paper.id} data-dir={paper.direction}>
  <PaperFigure paper={paper} caption={false} eager={feature} card />
  <div class="pcard__body">
    <p class="pcard__meta"><span class="dirtag">{dir.n} {dir.name}</span><span class="venue">{paper.venue === "Preprint" ? `Preprint ${paper.year}` : paper.venue}</span></p>
    <h3 class="pcard__name">{home ? <a href={home}>{paper.name}</a> : paper.name}</h3>
    <p class="pcard__title">{rest}</p>
    <Authors authors={paper.authors} />
    <Stats stats={paper.stats} cls="stats--card" />
    {paper.links.length > 0 && <p class="plinks">{paper.links.map((l) => <a href={l.url}>{l.label}</a>)}</p>}
  </div>
</article>

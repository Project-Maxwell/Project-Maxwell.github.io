---
// Direction A: one paper as an index row — venue and direction on the left, the work in the middle, its figure on the right.
import type { Paper } from "../data/papers";
import { DIRECTIONS } from "../data/site";
import Authors from "./Authors.astro";
import Stats from "./Stats.astro";
import PaperFigure from "./PaperFigure.astro";
const { paper, n } = Astro.props as { paper: Paper; n: number };
const dir = DIRECTIONS.find((d) => d.id === paper.direction)!;
const home = paper.links[0]?.url;
const rest = paper.title.startsWith(paper.name + ":") ? paper.title.slice(paper.name.length + 1).trim() : paper.title;
---
<li class="prow" id={paper.id} data-dir={paper.direction}>
  <div class="prow__meta">
    <span class="num">{String(n).padStart(2, "0")}</span>
    <span class="venue">{paper.venue === "Preprint" ? `Preprint ${paper.year}` : paper.venue}</span>
    <span class="dirtag">{dir.name}</span>
  </div>
  <div class="prow__main">
    <h3 class="prow__name">{home ? <a href={home}>{paper.name}</a> : paper.name}</h3>
    <p class="prow__title">{rest}</p>
    <Authors authors={paper.authors} />
    {paper.summary && <p class="prow__summary">{paper.summary}</p>}
    <Stats stats={paper.stats} />
    {paper.links.length > 0 && <p class="plinks">{paper.links.map((l) => <a href={l.url}>{l.label}</a>)}</p>}
  </div>
  <div class="prow__fig"><PaperFigure paper={paper} /></div>
</li>

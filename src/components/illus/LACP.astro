---
// LACP's three layers, redrawn from the architecture figure on the project page and in arXiv 2510.13821.
const layers = [
  ["Semantic", "PLAN, ACT, OBSERVE, ERROR; domain-specific content", "semantic content wrapped in a transaction"],
  ["Transactional", "Transaction IDs, signatures, two-phase commit, rollback, timeout, retry logic", "transaction wrapped in transport"],
  ["Transport", "Binary framing, flow control, heartbeat, error detection; HTTP/2, QUIC, WebSockets", ""],
];
---
<div class="illus illus--lacp" role="img" aria-label="LACP protocol stack: semantic, transactional and transport layers.">
  <p class="il-k">LLM-Agent Communication Protocol</p>
  <ol class="lacp">
    {layers.map(([name, keys, wrap], i) => (
      <>
        <li data-l={i + 1}>
          <span class="lacp__n">L{i + 1}</span><b>{name}</b><span class="lacp__keys">{keys}</span>
        </li>
        {wrap && <li class="lacp__wrap" aria-hidden="true"><span>↓</span>{wrap}</li>}
      </>
    ))}
  </ol>
</div>

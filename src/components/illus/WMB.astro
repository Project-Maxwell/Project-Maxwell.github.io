---
// The example problem published in the WirelessMathBench paper (arXiv 2505.14354, Figure 1), typeset with KaTeX at
// build time. The paper's figure prints options (A) and (D) identically, so only the question and its answer are shown.
import katex from "katex";
import "katex/dist/katex.min.css";
const tex = (s: string, display = false) => katex.renderToString(s, { throwOnError: true, displayMode: display, output: "html" });
const lhs = tex(String.raw`\boldsymbol{h}_k =`);
const ans = tex(String.raw`\boldsymbol{N}_2\,\mathrm{diag}(\boldsymbol{h}_{k2})\,\boldsymbol{\theta}_2 + \boldsymbol{N}_1\,\mathrm{diag}(\boldsymbol{h}_{k1})\,\boldsymbol{\theta}_1 + \boldsymbol{N}_2\,\mathrm{diag}(\boldsymbol{\theta}_2)\,\boldsymbol{D}\,\mathrm{diag}(\boldsymbol{\theta}_1)\,\boldsymbol{h}_{k1}`);
const ris = tex(String.raw`\mathrm{RIS}_1`), ris2 = tex(String.raw`\mathrm{RIS}_2`);
---
<div class="illus illus--wmb" role="img" aria-label="Example problem: in a double-RIS-assisted massive MIMO system, which expression is the user-k effective channel at the base station?">
  <p class="il-k">Example problem · multiple choice</p>
  <p class="wmb__ctx">Double-RIS-assisted massive MIMO: single-reflection links via <span set:html={ris} /> and <span set:html={ris2} />, and a double-reflection link through both.</p>
  <p class="wmb__q">Which expression correctly represents the user-<i>k</i> effective channel at the base station?</p>
  <p class="wmb__eq"><span set:html={lhs} /> <span class="wmb__mask">[MASK]</span></p>
  <p class="wmb__a"><span class="il-k">Answer (A)</span><span class="wmb__ans" set:html={ans} /></p>
</div>

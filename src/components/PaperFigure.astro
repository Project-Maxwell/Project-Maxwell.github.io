---
import type { Paper } from "../data/papers";
import { BASE } from "../lib/look";
import Field from "./Field.astro";
import XL from "./illus/XL.astro";
import WMB from "./illus/WMB.astro";
import LACP from "./illus/LACP.astro";
import R2M from "./illus/R2M.astro";
const ILLUS: Record<string, any> = { "wirelessmathbench-xl": XL, wirelessmathbench: WMB, lacp: LACP, radio2map: R2M };
const { paper, eager = false, caption = true, card = false } = Astro.props as { paper: Paper; eager?: boolean; caption?: boolean; card?: boolean };
const f = paper.figure;
const useCard = card && f?.card;   // cards show a crop that fills the frame
const Illus = card ? ILLUS[paper.id] : undefined;   // cards: a redrawn illustration in the site's style
---
{Illus ? (
  <figure class="pfig pfig--illus"><div class="pfig__frame"><Illus /></div></figure>
) : f ? (
  <figure class:list={["pfig", `pfig--${useCard ? "cover" : f.fit ?? "cover"}`]}>
    <div class="pfig__frame"><img src={`${BASE}${useCard ? f.card : f.src}`} alt={f.alt} width={useCard ? 1200 : f.w} height={useCard ? 750 : f.h} loading={eager ? "eager" : "lazy"} decoding="async" /></div>
    {caption && <figcaption>{f.caption} <a href={f.source}>Source</a></figcaption>}
  </figure>
) : (
  <figure class="pfig pfig--none" aria-hidden="true"><div class="pfig__frame"><Field /><span>{paper.name}</span><small>Figures with the arXiv release</small></div></figure>
)}

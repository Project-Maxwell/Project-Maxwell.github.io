---
import Base from "../layouts/Base.astro";
import { SITE } from "../data/site";
import { PEOPLE } from "../data/people";
import Avatar from "../components/Avatar.astro";
const groups = [["lead", "Lead"], ["member", "Members"], ["advisor", "Advisor"]] as const;
const jsonld = PEOPLE.map((p) => ({ "@context": "https://schema.org", "@type": "Person", name: p.name, ...(p.role ? { jobTitle: p.role } : {}),
  affiliation: { "@type": "Organization", name: p.affiliation }, memberOf: { "@type": "ResearchOrganization", name: SITE.name },
  ...(p.url ? { url: p.url } : {}) }));
---
<Base page="people" title="People" jsonld={jsonld} description={`The people of ${SITE.name}: ${PEOPLE.map((p) => p.name).join(", ")}.`}>
  <header class="page-head">
    <div class="wrap">
      <p class="label">People</p>
      <h1>The group</h1>
      <p>{SITE.name} is led by {SITE.lead.name} at {SITE.institution.name}; the projects are carried out by students and
        researchers at NTU and beyond.</p>
    </div>
  </header>
  <section class="section" style="border-bottom:0">
    <div class="wrap">
      {groups.map(([g, label]) => {
        const ps = PEOPLE.filter((p) => p.group === g);
        return ps.length > 0 && (
          <div class="people-group">
            <p class="label">{label}</p>
            <div class:list={["people", { "people--lead": g === "lead", "people--advisor": g === "advisor" }]}>
              {ps.map((p) => (
                <article class:list={["person", { "person--lead": g !== "member" }]} id={p.id}>
                  <Avatar person={p} size={g === "member" ? 64 : 120} />
                  <div>
                    <h3>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h3>
                    {p.role && <p class="person__role">{p.role}</p>}
                    <p class="person__aff">{p.affiliation}</p>
                  </div>
                  {p.bio && <p class="person__bio">{p.bio}</p>}
                </article>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Base>

---
import "../styles/global.css";
import { SITE } from "../data/site";
import Mark from "../components/Mark.astro";
import { LOOK } from "../lib/look";

interface Props { title?: string; description?: string; page?: "home" | "projects" | "people" | "join" | "other"; jsonld?: object[]; noindex?: boolean }
const { title, description = SITE.description, page = "other", jsonld = [], noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.line}`;
const canonical = new URL(Astro.url.pathname.replace(base, "/").replace(/index\.html$/, ""), Astro.site).href;
const ogImage = new URL("og.png", Astro.site).href;
const nav = [["projects", "Projects"], ["people", "People"], ["join", "Join us"]] as const;
const org = {
  "@context": "https://schema.org", "@type": "ResearchOrganization", name: SITE.name, url: Astro.site?.href,
  description: SITE.description, foundingDate: String(SITE.founded), logo: new URL("brand/icon.svg", Astro.site).href,
  founder: { "@type": "Person", name: SITE.lead.name, url: SITE.lead.url },
  parentOrganization: { "@type": "CollegeOrUniversity", name: SITE.institution.name, url: SITE.institution.url },
  sameAs: [SITE.github],
};
---
<!doctype html>
<html lang="en" class={`look-${LOOK}`}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href={`${base}brand/icon.svg`} type="image/svg+xml">
  <link rel="icon" href={`${base}brand/icon-32.png`} sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href={`${base}brand/icon-180.png`}>
  <meta name="theme-color" content={LOOK === "b" ? "#0B1830" : "#F6F4EE"}>
  <script is:inline>try{if(localStorage.getItem("maxwell-theme")==="dark")document.documentElement.dataset.theme="dark"}catch(e){}</script>
  <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonld])} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap">
      <a class="brand" href={import.meta.env.MAXWELL_PREVIEW ? `${base}index.html` : base} aria-label={`${SITE.name}, home`}><Mark /><span>Open<b>Maxwell</b></span></a>
      <nav class="nav" aria-label="Site">
        {nav.map(([id, label]) => <a href={`${base}${id}.html`} aria-current={page === id ? "page" : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-foot">
    <div class="wrap">
      <div>
        <p><b style="color:var(--ink);font-weight:600">{SITE.name}</b> is an open research group on large language models and agents for wireless communications.</p>
        <p>{SITE.institution.name}, {SITE.institution.place}. Led by <a href={SITE.lead.url}>{SITE.lead.name}</a>.</p>
        <div class="mode" role="group" aria-label="Colour scheme">
          <button type="button" data-mode="light" aria-pressed="true">Light</button><button type="button" data-mode="dark" aria-pressed="false">Dark</button>
        </div>
      </div>
      <div>
        <p class="label">Group</p>
        <ul>{nav.map(([id, label]) => <li><a href={`${base}${id}.html`}>{label}</a></li>)}</ul>
      </div>
      <div>
        <p class="label">Elsewhere</p>
        <ul><li><a href={SITE.github}>GitHub</a></li><li><a href={SITE.lead.url}>Xin Li</a></li><li><a href={`mailto:${SITE.lead.email}`}>{SITE.lead.email}</a></li></ul>
      </div>
      <p class="foot-small"><span>© {new Date().getFullYear()} {SITE.name}</span><span>Since {SITE.founded} · NTU Singapore</span></p>
    </div>
  </footer>
  <script is:inline>
    (function () {
      var root = document.documentElement, btns = document.querySelectorAll(".mode button");
      function show() { var d = root.dataset.theme === "dark"; btns.forEach(function (b) { b.setAttribute("aria-pressed", String((b.dataset.mode === "dark") === d)); }); }
      btns.forEach(function (b) { b.addEventListener("click", function () {
        if (b.dataset.mode === "dark") root.dataset.theme = "dark"; else delete root.dataset.theme;
        try { localStorage.setItem("maxwell-theme", b.dataset.mode); } catch (e) {}
        show();
      }); });
      show();
    })();
  </script>
</body>
</html>
